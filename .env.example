PORT=3000
NODE_ENV=development

DATABASE_URL="mysql://lifeos_user:lifeos_password@localhost:3306/lifeos"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowed browser origins. Required in production; any origin is allowed if unset in dev.
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app (0 = none). Rate limiting keys on the client IP.
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true
# Background jobs: daily reminders and notification cleanup.
SCHEDULER_ENABLED=true
# "log" = placeholder that writes emails to the log instead of sending them.
MAIL_TRANSPORT=log
MAIL_FROM="Life OS <no-reply@lifeos.local>"
