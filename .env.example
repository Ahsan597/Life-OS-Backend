PORT=3000
NODE_ENV=development

DATABASE_URL="mysql://lifeos_user:lifeos_password@localhost:3306/lifeos"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
