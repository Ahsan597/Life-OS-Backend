generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String?  @db.VarChar(100)
  timezone     String   @default("UTC") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Notification preferences. reminderTime is "HH:MM" in the user's timezone.
  remindersEnabled Boolean   @default(true) @map("reminders_enabled")
  reminderTime     String    @default("20:00") @map("reminder_time") @db.VarChar(5)
  emailReminders   Boolean   @default(false) @map("email_reminders")
  // Logical date the reminder job last handled this user, so it runs once a day.
  lastReminderOn   DateTime? @map("last_reminder_on") @db.Date

  refreshTokens   RefreshToken[]
  habits          Habit[]
  checkIns        CheckIn[]
  recommendations Recommendation[]
  notifications   Notification[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum HabitFrequency {
  daily
  weekly
  custom
}

model Habit {
  id          BigInt         @id @default(autoincrement())
  userId      BigInt         @map("user_id")
  title       String         @db.VarChar(150)
  description String?        @db.Text
  frequency   HabitFrequency @default(daily)
  targetDays  Json?          @map("target_days")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            HabitLog[]
  recommendations Recommendation[]

  @@index([userId, isActive])
  @@map("habits")
}

model HabitLog {
  id        BigInt   @id @default(autoincrement())
  habitId   BigInt   @map("habit_id")
  logDate   DateTime @map("log_date") @db.Date
  completed Boolean  @default(false)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, logDate])
  @@index([habitId, logDate])
  @@map("habit_logs")
}

model CheckIn {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  checkInDate DateTime @map("check_in_date") @db.Date
  mood        Int?     @db.TinyInt
  energy      Int?     @db.TinyInt
  sleepHours  Decimal? @map("sleep_hours") @db.Decimal(4, 1)
  stressLevel Int?     @map("stress_level") @db.TinyInt
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkInDate])
  @@index([userId, checkInDate])
  @@map("check_ins")
}

enum RecommendationSource {
  rule_based
  ml_based
}

enum RecommendationStatus {
  pending
  accepted
  dismissed
}

// Derived data: generated by the rule engine from habits/logs/check-ins and
// safe to wipe. Rows are kept (not recomputed from scratch) only so a user's
// accept/dismiss decision sticks: `dedupeKey` identifies one occurrence of a
// rule firing, e.g. "missed_in_a_row:15:2026-10-16".
model Recommendation {
  id        BigInt               @id @default(autoincrement())
  userId    BigInt               @map("user_id")
  habitId   BigInt?              @map("habit_id")
  source    RecommendationSource @default(rule_based)
  rule      String               @db.VarChar(50)
  dedupeKey String               @map("dedupe_key") @db.VarChar(150)
  message   String               @db.Text
  reason    String?              @db.Text
  status    RecommendationStatus @default(pending)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit? @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, status])
  @@map("recommendations")
}

enum NotificationType {
  reminder
  insight
  recommendation
}

// In-app notifications, created by background jobs (e.g. the daily reminder).
// `dedupeKey` names one occurrence, e.g. "daily_reminder:2026-10-27", so a
// job running twice (or on two servers) can never notify twice.
model Notification {
  id          BigInt           @id @default(autoincrement())
  userId      BigInt           @map("user_id")
  type        NotificationType
  dedupeKey   String           @map("dedupe_key") @db.VarChar(150)
  title       String           @db.VarChar(150)
  message     String           @db.Text
  // Deep-link payload for the client, e.g. { "habitIds": ["12"] }.
  data        Json?
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  // When the user asked to be notified (their local reminder time, in UTC).
  scheduledAt DateTime?        @map("scheduled_at")
  // When it was delivered outside the app (email); null = in-app only.
  sentAt      DateTime?        @map("sent_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}
